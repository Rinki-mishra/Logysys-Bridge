@page
@model IndexModel
@{
    ViewData["Title"] = "Create Logi-Sys files";
}

<section class="panel">
    <p class="eyebrow">Google Form</p>
    <h1>Read the response sheet and create the files Logi-Sys accepts.</h1>
    <p class="lead">
        @if (string.IsNullOrEmpty(Model.MailboxAddress))
        {
            <text>The organisation form keeps its answers in a private Google spreadsheet. This page reads that sheet and writes the India and overseas files.</text>
        }
        else
        {
            <text>Mail to @Model.MailboxAddress brings each new organisation-form response. The answers are in a private Google spreadsheet shared with that address. This page reads the sheet and writes the India and overseas files, with the same checks as an uploaded workbook.</text>
        }
    </p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <p class="banner ok" role="status">@Model.StatusMessage</p>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="banner" role="alert">@Model.ErrorMessage</p>
    }

    @if (!string.IsNullOrEmpty(Model.MailboxError))
    {
        <p class="banner" role="alert">@Model.MailboxError</p>
    }
    else if (Model.Notices.Count == 0)
    {
        <p class="banner">No organisation-form mail was found in the mailbox.</p>
    }
    else
    {
        <div class="table-wrap flat">
            <table>
                <thead>
                    <tr>
                        <th>Form</th>
                        <th>Last mail</th>
                        <th>Requestor</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var notice in Model.Notices)
                    {
                        <tr>
                            <td>
                                @notice.Title
                                <span>@(notice.Kind == "sheet" ? "Response spreadsheet" : "Form responses")</span>
                            </td>
                            <td>@notice.ReceivedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@(string.IsNullOrEmpty(notice.RequestorEmail) ? "—" : notice.RequestorEmail)</td>
                            <td>
                                <form method="post" asp-page-handler="Sheet" data-convert-form>
                                    <input type="hidden" name="kind" value="@notice.Kind" />
                                    <input type="hidden" name="sourceId" value="@notice.SourceId" />
                                    <input type="hidden" name="title" value="@notice.Title" />
                                    <button type="submit" class="small">Create Logi-Sys files</button>
                                </form>
                                <a class="text-link" href="@notice.OpenUrl" target="_blank" rel="noopener">Open in Google</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="connect-line">
        @if (Model.GoogleConnected)
        {
            <text>Signed in as the account that has the form.</text>
        }
        else if (!string.IsNullOrEmpty(Model.MailboxAddress))
        {
            <span>@Model.MailboxAddress already has the sheet. Creating the files opens it, requests the code to that mailbox, and enters the code.</span>
        }
    </p>
</section>

<section class="panel step">
    <h2>Client workbook</h2>
    <p class="lead">Load Organisation Creation Request Form (Responses) into Choose File. Edge opens the Form Responses 1 tab. The verification code is read from the mailbox and entered. Then create the Logi-Sys files.</p>

    <form method="post" enctype="multipart/form-data" data-convert-form>
        <label class="file-field" for="client-file">
            <span>Client workbook</span>
            <input id="client-file" type="file" name="ClientFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
        </label>
        <button type="button" class="secondary" data-load-sheet="@Url.Page("/Index", pageHandler: "MailSheet")">Load spreadsheet from mail</button>
        <button type="submit">Create Logi-Sys files</button>
        <p class="connect-line" data-load-status></p>
    </form>
</section>

<section class="steps">
    <article>
        <h2>1. Read</h2>
        <p>Company name, organisation type, address, city, state, country, postal code, and email come from the client sheet.</p>
    </article>
    <article>
        <h2>2. Check</h2>
        <p>An organisation already in Logi-Sys is never created again; its new address goes to an address updates file. Repeated rows are merged into one. A row is held back when the country is unknown, the city is a street, or the city and state are the same word and that word is not a state.</p>
    </article>
    <article>
        <h2>3. Download</h2>
        <p>Upload each finished file in Logi-Sys under Directories, Organisations, Import. Fix held rows in the client sheet and run them again.</p>
    </article>
</section>
