@page
@model IndexModel
@{
    ViewData["Title"] = "Create Logi-Sys files";
}

<section class="panel">
    <p class="eyebrow">Client workbook</p>
    <h1>Create the files Logi-Sys accepts.</h1>
    <p class="lead">Load Organisation Creation Request Form (Responses) into Choose File. Edge opens the Form Responses 1 tab. The verification code is read from the mailbox and entered. Then create the Logi-Sys files.</p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <p class="banner ok" role="status">@Model.StatusMessage</p>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="banner" role="alert">@Model.ErrorMessage</p>
    }

    <form method="post" enctype="multipart/form-data" data-convert-form>
        <label class="file-field" for="client-file">
            <span>Client workbook</span>
            <input id="client-file" type="file" name="ClientFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
        </label>
        <button type="button" class="secondary" data-load-sheet="@Url.Page("/Index", pageHandler: "MailSheet")">Load spreadsheet from mail</button>
        <button type="submit">Create Logi-Sys files</button>
        <p class="connect-line" data-load-status></p>
    </form>
    <p class="lead">
        @if (Model.DriveAccount is not null)
        {
            <text>GST certificates are read from Google Drive as @Model.DriveAccount and their GSTIN goes into REG-GSTIN.</text>
        }
        else
        {
            <text>GST certificates are not being read because Google Drive is not connected. <a class="text-link" asp-page="/Google/Index">Connect Google Drive</a></text>
        }
    </p>
</section>

<section class="steps">
    <article>
        <h2>1. Read</h2>
        <p>Company name, organisation type, address, city, state, country, postal code, and email come from the client sheet.</p>
    </article>
    <article>
        <h2>2. Check</h2>
        <p>An organisation already in Logi-Sys is never created again; its new address goes to an address updates file. Repeated rows are merged into one. A row is held back when the country is unknown, the city is a street, or the city and state are the same word and that word is not a state.</p>
    </article>
    <article>
        <h2>3. Download</h2>
        <p>Upload each finished file in Logi-Sys under Directories, Organisations, Import. Fix held rows in the client sheet and run them again.</p>
    </article>
</section>
