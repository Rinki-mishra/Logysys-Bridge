@page "{id:guid}"
@model LogisysOrgConverter.Pages.Runs.DetailModel
@using LogisysOrgConverter.Data
@{
    ViewData["Title"] = "Converted files";
    var run = Model.Run!;
    var when = DetailModel.IndiaTime(run.CreatedAtUtc).ToString("d MMM yyyy, HH:mm");
    var mergedCount = run.Rows.Count(row => row.Status == RowStatuses.Merged);
    var updateCount = run.Rows.Count(row => row.Status == RowStatuses.Update);
    var ledgerRows = run.Rows
        .Select(row => (Row: row, Checklist: LedgerJson.Read(row.LedgerJson)))
        .Where(item => item.Checklist is not null)
        .Select(item => (item.Row, Checklist: item.Checklist!))
        .ToList();
    var agents = run.Rows.Where(row => row.Template == RowTemplates.OverseasAgent).ToList();
    var waitingAgents = agents.Count(row => row.Status == RowStatuses.Approval);
    var approvedAgents = agents.Count(row => row.Status == RowStatuses.Ready);
    var templates = new[] { (RowTemplates.India, run.IndiaCount), (RowTemplates.Overseas, run.OverseasCount), (RowTemplates.OverseasAgent, approvedAgents) }
        .Where(item => item.Item2 > 0).ToList();
}

<section class="panel">
    <p class="eyebrow">@run.SourceFileName</p>
    <h1>@run.IndiaCount India @(run.IndiaCount == 1 ? "row" : "rows") and @run.OverseasCount overseas @(run.OverseasCount == 1 ? "row" : "rows") are ready. @run.HeldCount @(run.HeldCount == 1 ? "was" : "were") held back.</h1>
    <p class="lead">Converted @when IST. Ready rows are in the download files. Held rows were left out.@if (mergedCount > 0)
        {
            <text> @mergedCount repeated @(mergedCount == 1 ? "row was" : "rows were") merged into the first row for the same organisation, so it is created once.</text>
        }@if (updateCount > 0)
        {
            <text> @updateCount @(updateCount == 1 ? "organisation is" : "organisations are") already in Logi-Sys and will not be created again; apply the new address from the address updates file.</text>
        }@if (waitingAgents > 0)
        {
            <text> @waitingAgents overseas @(waitingAgents == 1 ? "agent waits" : "agents wait") for approval from @Model.AgentApprover before being created.</text>
        }</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="banner ok" role="status">@Model.Message</p>
    }

    <div class="actions">
        @if (run.IndiaCount > 0)
        {
            <a class="button" asp-page="/Runs/Detail" asp-route-id="@run.Id" asp-page-handler="File" asp-route-which="india">Download India file</a>
        }
        else
        {
            <span class="button disabled">No India rows</span>
        }
        @if (run.OverseasCount > 0)
        {
            <a class="button secondary" asp-page="/Runs/Detail" asp-route-id="@run.Id" asp-page-handler="File" asp-route-which="overseas">Download overseas file</a>
        }
        else
        {
            <span class="button disabled">No overseas rows</span>
        }
        @if (approvedAgents > 0)
        {
            <a class="button secondary" asp-page="/Runs/Detail" asp-route-id="@run.Id" asp-page-handler="File" asp-route-which="agents">Download approved agents file</a>
        }
        @if (run.UpdatesFile is { Length: > 0 })
        {
            <a class="button secondary" asp-page="/Runs/Detail" asp-route-id="@run.Id" asp-page-handler="File" asp-route-which="updates">Download address updates</a>
        }
        <a class="text-link" asp-page="/Index">Convert another sheet</a>
    </div>
</section>

@if (agents.Count > 0)
{
    <section class="panel step" id="agents">
        <p class="eyebrow">Overseas agents</p>
        <h2>Approval from @Model.AgentApprover: @agents.Count @(agents.Count == 1 ? "agent" : "agents")</h2>
        <p class="lead">
            Overseas agents are not put in the overseas file. Send them to @Model.AgentApprover for approval, then mark each one.
            Approved agents go into a separate approved agents file to import; agents not approved are never created.
        </p>
        @if (Model.ApprovalDraft is { } approval)
        {
            <details class="draft">
                <summary><strong>@approval.RecipientEmail</strong> <span>@approval.Subject</span></summary>
                <pre>@approval.Body</pre>
            </details>
            <form method="post" asp-page-handler="SendApproval" asp-route-id="@run.Id" class="send-form">
                <button type="submit">@(Model.UsesSmtp ? $"Send approval request to {Model.AgentApprover}" : "Save approval request as a file")</button>
            </form>
        }
        @foreach (var agent in agents)
        {
            var state = agent.Status switch
            {
                RowStatuses.Approval => agent.ApprovalRequestedAtUtc is DateTime asked
                    ? $"Waiting for approval, asked {DetailModel.IndiaTime(asked):d MMM, HH:mm} IST"
                    : "Waiting for approval, not sent yet",
                RowStatuses.Ready => $"Approved · {agent.ImportStatus ?? "not imported yet"}",
                _ => "Not approved"
            };
            <details class="ledger-card @(agent.Status == RowStatuses.Ready ? "done" : agent.Status == RowStatuses.Rejected ? "missing" : "open")">
                <summary>
                    <strong>@agent.OrganisationName</strong>
                    <span class="ledger-meta">Row @agent.SourceRowNumber · @agent.Country</span>
                    <span class="ledger-state">@state</span>
                </summary>
                @if (!string.IsNullOrWhiteSpace(agent.ApprovalDetails))
                {
                    <ul class="ledger-items">
                        @foreach (var line in agent.ApprovalDetails.Split('\n'))
                        {
                            <li><span>@line</span></li>
                        }
                    </ul>
                }
                @if (agent.ImportStatus is null)
                {
                    <form method="post" asp-page-handler="Agent" asp-route-id="@run.Id" class="mark-form">
                        <input type="hidden" name="rowId" value="@agent.Id" />
                        @if (agent.Status != RowStatuses.Ready)
                        {
                            <button type="submit" name="approved" value="true" class="small">Mark approved</button>
                        }
                        @if (agent.Status != RowStatuses.Rejected)
                        {
                            <button type="submit" name="approved" value="false" class="small ghost">Mark not approved</button>
                        }
                    </form>
                }
            </details>
        }
    </section>
}

@if (templates.Count > 0)
{
    <section class="panel step">
        <p class="eyebrow">After the Logi-Sys import</p>
        <h2>Record what Logi-Sys created</h2>
        <p class="lead">
            Logi-Sys lists only the organisations it could not create. Upload that log, and every other organisation in the file is marked created.
            If the import had no errors, click <strong>Mark all created</strong> without a file.
        </p>
        <div class="import-grid">
            @foreach (var (template, count) in templates)
            {
                <form method="post" asp-page-handler="ImportResult" asp-route-id="@run.Id" enctype="multipart/form-data" class="import-card">
                    <input type="hidden" name="template" value="@template" />
                    <h3>@template file <span>@count @(count == 1 ? "organisation" : "organisations")</span></h3>
                    <label class="file-field">
                        <span>Logi-Sys error log (optional)</span>
                        <input type="file" name="log" accept=".txt,.log,.csv,text/plain" />
                    </label>
                    <button type="submit">Save result</button>
                    <button type="submit" name="markAll" value="true" class="ghost">Mark all created</button>
                </form>
            }
        </div>
    </section>
}

<section class="panel step">
    <p class="eyebrow">Email the requestor</p>
    @if (Model.Drafts.Count == 0)
    {
        <h2>No emails waiting</h2>
        <p class="lead">An email is prepared once an organisation is marked created and its requestor has an email address in column B. Each organisation is emailed only once.</p>
    }
    else
    {
        <h2>@Model.Drafts.Count @(Model.Drafts.Count == 1 ? "email is" : "emails are") ready to send</h2>
        <p class="lead">
            @if (Model.UsesSmtp)
            {
                <text>These go out through your SMTP mailbox when you click Send.</text>
            }
            else
            {
                <text>SMTP is not set up yet, so Send saves each email as an .eml file in <code>@Model.PickupFolder</code> instead of sending it.</text>
            }
        </p>
        @foreach (var draft in Model.Drafts)
        {
            <details class="draft">
                <summary><strong>@draft.RecipientEmail</strong> <span>@draft.Subject</span></summary>
                <pre>@draft.Body</pre>
            </details>
        }
        <form method="post" asp-page-handler="Send" asp-route-id="@run.Id" class="send-form">
            <button type="submit">@(Model.UsesSmtp ? "Send emails" : "Save emails as files")</button>
        </form>
    }
</section>

@if (ledgerRows.Count > 0)
{
    <section class="panel step" id="ledger">
        <p class="eyebrow">To be invoiced</p>
        <h2>Ledger link: @ledgerRows.Count @(ledgerRows.Count == 1 ? "organisation" : "organisations")</h2>
        <p class="lead">
            Column I says these organisations are to be invoiced, so their ledger has to be linked in Logi-Sys.
            Documents the client gave in the form are checked here; the rest has to be collected, and the approvals taken, before linking.
        </p>
        <div class="actions">
            <a class="button secondary" asp-page="/Runs/Detail" asp-route-id="@run.Id" asp-page-handler="LedgerFile">Download ledger checklist</a>
        </div>
        @if (Model.LedgerDrafts.Count > 0)
        {
            <h3>@Model.LedgerDrafts.Count document request @(Model.LedgerDrafts.Count == 1 ? "email is" : "emails are") ready</h3>
            <p class="lead">
                Each requestor gets one email listing the documents and approvals still needed for their organisations.
                @(Model.UsesSmtp ? "They go out through your SMTP mailbox." : $"SMTP is not set up yet, so they are saved as .eml files in {Model.PickupFolder}.")
                An organisation is asked only once.
            </p>
            @foreach (var draft in Model.LedgerDrafts)
            {
                <details class="draft">
                    <summary><strong>@draft.RecipientEmail</strong> <span>@draft.Subject</span></summary>
                    <pre>@draft.Body</pre>
                </details>
            }
            <form method="post" asp-page-handler="SendLedger" asp-route-id="@run.Id" class="send-form">
                <button type="submit">@(Model.UsesSmtp ? "Send document requests" : "Save document requests as files")</button>
            </form>
        }
        @foreach (var (row, checklist) in ledgerRows)
        {
            <details class="ledger-card @(row.LedgerLinkedAtUtc is not null ? "done" : checklist.MissingCount > 0 ? "missing" : "open")">
                <summary>
                    <strong>@row.OrganisationName</strong>
                    <span class="ledger-meta">Row @row.SourceRowNumber · @checklist.Category · @(row.Status == RowStatuses.Update ? "Already in Logi-Sys" : row.Status)</span>
                    <span class="ledger-state">
                        @(row.LedgerLinkedAtUtc is DateTime linkedAt
                            ? $"Ledger linked {DetailModel.IndiaTime(linkedAt):d MMM, HH:mm} IST"
                            : checklist.Summary)
                        @if (row.LedgerLinkedAtUtc is null && row.LedgerRequestedAtUtc is DateTime requestedAt)
                        {
                            <text> Documents requested @DetailModel.IndiaTime(requestedAt).ToString("d MMM, HH:mm") IST.</text>
                        }
                    </span>
                </summary>
                @if (checklist.Sections.Count == 0)
                {
                    <p class="lead">No ledger rule matches this organisation's type or country. Check it with the accounts team.</p>
                }
                @foreach (var part in checklist.Sections)
                {
                    <h3>@part.Title</h3>
                    <ul class="ledger-items">
                        @foreach (var item in part.Items)
                        {
                            <li>
                                <span class="badge @item.State.ToLowerInvariant()">@BadgeText(item.State)</span>
                                <span>@item.Label@(string.IsNullOrWhiteSpace(item.Detail) ? "" : $" — {item.Detail}")</span>
                            </li>
                        }
                    </ul>
                    @foreach (var note in part.Notes)
                    {
                        <p class="ledger-note">@note</p>
                    }
                }
                <form method="post" asp-page-handler="Ledger" asp-route-id="@run.Id" class="mark-form">
                    <input type="hidden" name="rowId" value="@row.Id" />
                    @if (row.LedgerLinkedAtUtc is null)
                    {
                        <button type="submit" name="linked" value="true" class="small">Mark ledger linked</button>
                    }
                    else
                    {
                        <button type="submit" name="linked" value="false" class="small ghost">Clear ledger linked</button>
                    }
                </form>
            </details>
        }
    </section>
}

<section class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Row</th>
                <th>Organisation</th>
                <th>File</th>
                <th>Branch name</th>
                <th>Country</th>
                <th>Requestor</th>
                <th>Result</th>
                <th>Logi-Sys</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in run.Rows)
            {
                <tr class="@(row.Status is RowStatuses.Merged or RowStatuses.Update or RowStatuses.Approval ? "merged" : row.Status is RowStatuses.Held or RowStatuses.Rejected ? "held" : row.ImportStatus == ImportStatuses.Failed ? "held" : "ready")">
                    <td>@row.SourceRowNumber</td>
                    <td>@(string.IsNullOrWhiteSpace(row.OrganisationName) ? "—" : row.OrganisationName)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.Template) ? "—" : row.Template)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.BranchName) ? "—" : row.BranchName)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.Country) ? "—" : row.Country)</td>
                    <td>
                        @(row.RequesterName ?? "—")
                        <span>@(row.RequesterEmail ?? "No email in column B")</span>
                    </td>
                    <td>
                        <strong>@(row.Status switch
                        {
                            RowStatuses.Update => "Address update",
                            RowStatuses.Approval => "Waiting for approval",
                            RowStatuses.Rejected => "Not approved",
                            _ => row.Status
                        })</strong>
                        @if (!string.IsNullOrWhiteSpace(row.Reason))
                        {
                            <span>@row.Reason</span>
                        }
                        @if (Model.PendingElsewhere.TryGetValue(row.Id, out var pending))
                        {
                            <span class="warning">@pending</span>
                        }
                    </td>
                    <td>
                        @if (row.Status == "Ready")
                        {
                            <strong>@(row.ImportStatus ?? "Not imported yet")</strong>
                            @if (!string.IsNullOrWhiteSpace(row.ImportMessage))
                            {
                                <span>@row.ImportMessage</span>
                            }
                            @if (row.EmailedAtUtc is not null)
                            {
                                <span>Emailed @DetailModel.IndiaTime(row.EmailedAtUtc.Value).ToString("d MMM, HH:mm") IST</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Mark" asp-route-id="@run.Id" class="mark-form">
                                    <input type="hidden" name="rowId" value="@row.Id" />
                                    @if (row.ImportStatus != ImportStatuses.Created)
                                    {
                                        <button type="submit" name="status" value="@ImportStatuses.Created" class="small">Mark created</button>
                                    }
                                    @if (row.ImportStatus != ImportStatuses.Failed)
                                    {
                                        <button type="submit" name="status" value="@ImportStatuses.Failed" class="small ghost">Mark failed</button>
                                    }
                                </form>
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@if (Model.Sent.Count > 0)
{
    <section class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>When (IST)</th>
                    <th>To</th>
                    <th>Organisations</th>
                    <th>How</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mail in Model.Sent)
                {
                    <tr class="@(mail.Status == "Sent" ? "ready" : "held")">
                        <td>@DetailModel.IndiaTime(mail.CreatedAtUtc).ToString("d MMM, HH:mm")</td>
                        <td>@mail.RecipientEmail</td>
                        <td>@mail.Organisations</td>
                        <td>@(mail.Delivery == "SMTP" ? "Email" : "Saved file")</td>
                        <td>
                            <strong>@mail.Status</strong>
                            @if (!string.IsNullOrWhiteSpace(mail.Error))
                            {
                                <span>@mail.Error</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@functions {
    private static string BadgeText(string state) => state switch
    {
        LogisysOrgConverter.Conversion.LedgerItemStates.Provided => "In the form",
        LogisysOrgConverter.Conversion.LedgerItemStates.Missing => "Missing",
        LogisysOrgConverter.Conversion.LedgerItemStates.Collect => "To collect",
        LogisysOrgConverter.Conversion.LedgerItemStates.Approval => "Approval",
        _ => "Optional"
    };
}
